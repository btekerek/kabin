# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database (Postgres, all environments) ---
POSTGRES_DB=kabin
POSTGRES_USER=kabin
POSTGRES_PASSWORD=kabin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
# Comma-separated list of allowed origins for the Flutter web/dev client, if any.
CORS_ALLOWED_ORIGINS=

# --- Real-time layer (Django Channels) ---
# Leave unset for local dev (falls back to the in-memory channel layer).
# Set to a redis:// URL in any environment with more than one process.
REDIS_URL=

# --- Agora (media) ---
# Personal free-tier account for now. Switching to the company account
# later should be nothing but changing these two values.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Session domain config ---
SESSION_LISTENER_CAP_DEFAULT=500
